{
  // Cloudflare Worker with static assets.
  //
  // `name` DOIT correspondre au nom du projet Workers Builds connecté au dépôt,
  // qui est `fondation-site` — le nom créé dans Cloudflare au « Connect to Git ».
  // `solage-capitale` est le nom du paquet npm et la racine du domaine : deux
  // choses sans rapport avec le nom du Worker.
  //
  // Ce fichier disait `solage-capitale`, et le déploiement du 2026-08-12 a émis :
  //   « Failed to match Worker name … the CI system expected "fondation-site".
  //     Overriding using the CI provided Worker name. »
  // Le CI passe outre, donc ce n'était qu'un avertissement — mais Cloudflare ouvre
  // des pull requests pour résorber l'écart, et un `npx wrangler deploy` lancé
  // depuis un poste local aurait, lui, créé un SECOND Worker portant l'autre nom.
  //
  // (Ce commentaire annonçait `exterminateur-qc` jusqu'à la session 4, deux lignes
  // au-dessus du bon nom : encore un fichier hérité qui documentait l'autre site.)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fondation-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",

  // Le domaine, acheté le 2026-08-11. C'est le SEUL endroit du dépôt où il est
  // écrit en dur, et il n'y est pas comme contenu : c'est la cible de
  // déploiement. Tout le rendu (canoniques, hreflang, sitemap, JSON-LD,
  // courriels sortants) passe par `SITE_URL` au build.
  //
  // `custom_domain: true` fait créer par Cloudflare l'enregistrement DNS de
  // l'apex vers ce Worker. Ça exige que la zone `solagecapitale.ca` soit déjà
  // dans le compte.
  //
  // ⚠ `www` n'est PAS déclaré ici, volontairement. Deux domaines personnalisés
  // serviraient les 182 pages sous deux hôtes ; les canoniques pointent toutes
  // vers l'apex, mais autant ne pas créer le doublon. `www` se règle par une
  // Redirect Rule Cloudflare vers l'apex (301). Le handler de formulaire accepte
  // déjà l'origine `www` (CANONICAL_HOSTS dans worker/lead-form.ts) au cas où
  // une page serait servie de là.
  "routes": [
    {
      "pattern": "solagecapitale.ca",
      "custom_domain": true
    }
  ],

  "assets": {
    // `npm run build` emits a flat static tree here (no adapter, no dist/client).
    "directory": "./dist",
    "binding": "ASSETS",

    // "none" = an asset miss falls through to worker/index.ts, which then serves
    // the correct localized 404 with a real 404 status. The alternative,
    // "404-page", would serve /404.html for everything, including URLs under /en/,
    // handing English visitors a French error page.
    "not_found_handling": "none"
  },

  // ⚠ LE WORKER NE VOIT PAS LE `SITE_URL` DU BUILD.
  //
  // `SITE_URL=… npm run build` paramètre Astro, pas le Worker : `wrangler deploy`
  // est une commande distincte et n'hérite pas de cette variable. Sans la ligne
  // ci-dessous, `src/lib/constants.ts` retombe sur son défaut de développement et
  // le Worker travaille avec `http://localhost:4321` — donc chaque courriel de
  // prospect porterait un lien « Envoyé depuis : http://localhost:4321/… » et le
  // locataire ne pourrait pas cliquer jusqu'à la page d'origine.
  //
  // C'est une variable de déploiement, pas du contenu : sa place est ici, au même
  // titre que la route. Les secrets (MAILGUN_API_KEY) restent dans le dashboard.
  // ⚠ CE BLOC DÉFINIT L'ENSEMBLE COMPLET DES VARIABLES EN CLAIR DU WORKER.
  //
  // Une variable en clair ajoutée UNIQUEMENT dans le tableau de bord est retirée
  // au déploiement suivant, parce que le déploiement applique les liaisons de ce
  // fichier. Le piège est vicieux : le formulaire marche le jour où on pose la
  // variable à la main, puis meurt au prochain `git push` sans que rien ne change
  // dans le dépôt. D'où : tout ce qui n'est pas secret vit ICI, versionné.
  //
  // **Les SECRETS ne sont pas concernés** — ils sont stockés à part et survivent
  // aux déploiements. `MAILGUN_API_KEY` est donc le seul à poser dans le tableau
  // de bord, en type « Secret ».
  //
  // Aucune de ces trois valeurs n'est confidentielle : le domaine est public,
  // `mg.` est visible dans les en-têtes de tout courriel envoyé, et
  // `contact@solagecapitale.ca` est déjà publié sur /contact/.
  "vars": {
    // Le Worker N'HÉRITE PAS du SITE_URL du build : `wrangler deploy` et
    // `npm run build` sont deux commandes distinctes. Sans ça, les courriels de
    // prospects portaient « Envoyé depuis : http://localhost:4321/… ».
    "SITE_URL": "https://solagecapitale.ca",

    // Le SOUS-DOMAINE Mailgun vérifié — jamais l'apex. Mailgun exige des MX sur
    // le domaine qu'il vérifie, et l'apex porte ceux de Cloudflare Email Routing
    // qui font vivre contact@solagecapitale.ca. Vérifier Mailgun sur l'apex
    // ferait disparaître l'adresse de contact en silence.
    "MAILGUN_DOMAIN": "mg.solagecapitale.ca",

    // Où arrivent les demandes. Devient la boîte du locataire au handoff
    // (HANDOFF-TENANT.md §4) — un changement par commit, donc traçable.
    "LEAD_TO_EMAIL": "contact@solagecapitale.ca"

    // "MAILGUN_BASE_URL": "https://api.eu.mailgun.net"
    //   ↑ À DÉCOMMENTER SI LE COMPTE MAILGUN EST EN RÉGION UE. Sans lui, l'API
    //   répond 401 avec des identifiants pourtant valides, et on part chercher
    //   le problème dans le DNS.
    //
    // "LEAD_BCC": "…"
    //   ↑ Copie pour le registre des demandes. À convenir PAR ÉCRIT avec le
    //   locataire : une copie non annoncée d'un courriel contenant des
    //   renseignements personnels n'est pas acceptable (HANDOFF-TENANT.md §4).
  },

  // Surfaces console.error from the lead handler in the dashboard. Without this the
  // only observability on a failed submission is nothing at all.
  "observability": {
    "enabled": true
  }
}
