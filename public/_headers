# En-têtes de sécurité et de cache — phase 9.
#
# POURQUOI CE FICHIER ET PAS DU CODE DANS LE WORKER. Avec `main` + un binding
# `assets`, Cloudflare sert l'asset statique EN PREMIER et n'invoque le Worker
# que lorsqu'aucun asset ne correspond (voir worker/index.ts). Le Worker ne voit
# donc jamais passer une vraie page : y poser des en-têtes n'en mettrait sur
# aucune des 182. `_headers` est appliqué à la périphérie, sans invocation.
#
# ⚠ À VÉRIFIER AU PREMIER DÉPLOIEMENT (docs/DEPLOY.md) : que la plateforme lit
# bien ce fichier pour un Worker à assets statiques, en regardant les en-têtes
# d'une réponse réelle — `curl -sI https://<domaine>/ | grep -i content-security`.
# Si elle ne le lit pas, le repli est `run_worker_first` dans wrangler.jsonc, qui
# fait passer chaque requête par le Worker : ça marche, mais ça coûte une
# invocation par requête. Ne pas supposer que c'est en place — le vérifier.

/*
  # Le site sort 0 octet de JS client (règle 7), donc la CSP peut être stricte
  # au point d'interdire le script tout court. Le JSON-LD n'est pas exécuté —
  # c'est un bloc de données, pas un script — et reste lisible par les moteurs.
  Content-Security-Policy: default-src 'self'; script-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
  # Redondant avec `frame-ancestors 'none'`, gardé pour les navigateurs anciens.
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=()
  # PAS de `preload`. La liste de préchargement HSTS est un engagement long et
  # pénible à défaire, et cet actif est destiné à être loué : le locataire doit
  # pouvoir déplacer le domaine sans hériter d'une contrainte qu'il n'a pas prise.
  # `max-age` seul donne l'essentiel de la protection.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Les fichiers d'Astro portent un hash de contenu dans leur nom : leur URL change
# dès que leur contenu change, donc ils sont immuables par construction.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Les polices n'ont PAS de hash (elles sont servies depuis public/), donc pas
# d'`immutable` : un remplacement doit pouvoir se propager. Un an de cache avec
# revalidation reste le bon compromis pour un fichier qui ne bouge presque jamais.
/fonts/*
  Cache-Control: public, max-age=31536000
  Access-Control-Allow-Origin: *
